FROM golang:1.27-alpine AS build

WORKDIR /src

# go.sum may not exist yet on a fresh checkout, so the wildcard keeps this COPY valid.
COPY go.mod go.sum* ./
RUN go mod download

COPY cmd/ ./cmd/
COPY internal/ ./internal/

ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown

RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /out/arcane-mcp ./cmd/arcane-mcp

FROM gcr.io/distroless/static:nonroot

COPY --from=build /out/arcane-mcp /arcane-mcp

USER nonroot:nonroot
# No HEALTHCHECK: the server speaks MCP over stdio and stays silent until a message arrives.
ENTRYPOINT ["/arcane-mcp"]
