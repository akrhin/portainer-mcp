      "type": "object"
    },
    "name": "system_status",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "Status": {
          "description": "up when the server is healthy",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "System version"
    },
    "description": "Portainer server version, API version and edition. Use it to check which features this server has before relying on them.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
