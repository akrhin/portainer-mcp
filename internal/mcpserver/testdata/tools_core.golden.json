      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "System info"
    },
    "description": "Runtime information of the Portainer server (host, platform, CPUs, memory). Use it to describe the deployment, not to act on it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "description": "Name of a configured Portainer instance; defaults to the first one.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "system_info",
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "System status"
    },
    "description": "Health of the Portainer server itself. Use it as a liveness check before a batch of calls.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "description": "Name of a configured Portainer instance; defaults to the first one.",
          "type": "string"
        }
