[
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Inspect environment"
    },
    "description": "One environment with its connection details and snapshot history. Use it after environment_list to check whether the agent behind an environment is reachable.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Environment id from environment_list",
          "type": "integer"
        },
        "instance": {
          "description": "Name of a configured Portainer instance; defaults to the first one.",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "environment_inspect",
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "Id": {
          "type": "integer"
        },
        "Name": {
          "type": "string"
        },
        "Snapshots": {
          "description": "Snapshot history, newest last.",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "List environments"
    },
    "description": "Environments (endpoints) reachable through this Portainer, without snapshots. Use it to find the environment id that other toolsets need.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "description": "Name of a configured Portainer instance; defaults to the first one.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "environment_list",
    "outputSchema": {
      "properties": {
        "environments": {
          "items": {
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "description": "up, down or unknown",
                "type": "string"
              },
              "type": {
                "description": "docker, agent, azure, edge-agent, kubernetes-local, kubernetes or edge-kubernetes",
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "environments"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true,
      "title": "Get settings"
    },
    "description": "Effective Portainer settings (authentication, edge, snapshot interval, templates). Use it when behaviour depends on configuration; nothing here changes it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "instance": {
          "description": "Name of a configured Portainer instance; defaults to the first one.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "settings_get",
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    }
  },
  {
